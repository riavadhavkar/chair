// Copy to Secrets.xcconfig (gitignored) to override SetWatch.xcconfig.
// The app itself holds no API keys — Gemini, ElevenLabs and MongoDB keys live
// in backend/.env. "//" starts a comment here, so write URLs as https:/$()/host.

SETWATCH_USE_MOCK_DATA = NO
SETWATCH_BACKEND_BASE_URL = https:/$()/api.yourdomain.tech
