# Copy to .env and fill in. Never commit the real .env file.

PORT=8080

# Google AI Studio key used to turn raw MTA alert text into a plain-language sentence.
GEMINI_API_KEY=
# Adjust if this model id has been retired/renamed since the API docs were last checked.
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas connection string (used for rolling delay history / trend counts).
MONGODB_URI=
MONGODB_DB_NAME=transitTracker
