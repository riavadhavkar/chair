PORT=8080

# Where "near me" defaults to (MVP: one borough around the demo venue)
DEFAULT_LAT=40.7397
DEFAULT_LON=-73.9925
DEFAULT_LABEL=Chelsea
DEMO_BOROUGH=Manhattan
DEFAULT_RADIUS_METERS=1500

# Optional — raises NYC Open Data rate limits
NYC_OPEN_DATA_APP_TOKEN=

# TMDB — set ONE of these (themoviedb.org/settings/api)
TMDB_READ_TOKEN=
TMDB_API_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

MONGODB_URI=
MONGODB_DB_NAME=setWatch

# For /go/:id share pages (iMessage preview cards)
PUBLIC_BASE_URL=
MAPBOX_ACCESS_TOKEN=
