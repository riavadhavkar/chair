PORT=8080

# MongoDB Atlas. Without it the server uses an in-memory store (check-ins lost on restart).
MONGODB_URI=
MONGODB_DB_NAME=chair

# Import (npm run import)
IMPORT_SINCE=2012-01-01
IMPORT_BOROUGH=Manhattan
SPOTS_PER_NEIGHBORHOOD=12

# Optional — raises NYC Open Data rate limits
NYC_OPEN_DATA_APP_TOKEN=
# Optional but recommended — free key from api-portal.nyc.gov, much better intersection geocoding
NYC_GEOCLIENT_KEY=

# Live
TODAY_BOROUGH=Manhattan
CHECKIN_RADIUS_METERS=150

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
